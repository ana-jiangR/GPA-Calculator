.page .page__bd {
  padding-bottom: 0;
}

.page .page__ft {
  padding-top: 16px;
}

.page .reset-all-area {
  margin: 30px 0 0;
}

.page .project-notice {
  margin: 36px 0 0;
  padding: 14px 16px;
  border: 1px solid var(--weui-FG-3);
  border-radius: 8px;
  background-color: var(--weui-BG-1);
  color: var(--weui-FG-1);
  font-size: 0.75rem;
  line-height: 1.65;
}

.project-notice__title {
  margin-bottom: 6px;
  color: var(--weui-FG-0);
  font-weight: 600;
}

.project-notice__body {
  margin-bottom: 12px;
}

.project-notice__contact {
  display: flex;
  align-items: center;
  margin-top: 8px;
}

.project-notice__label {
  flex-shrink: 0;
  width: 44px;
  margin-right: 8px;
}

.project-notice__detail {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.project-notice .project-notice__button {
  flex-shrink: 0;
  width: auto;
  margin: 0 0 0 12px;
  padding: 0 10px;
  border: 1px solid var(--weui-FG-3);
  border-radius: 6px;
  background-color: var(--weui-BG-2);
  color: var(--weui-LINK);
  font-size: 0.75rem;
  font-weight: 400;
  line-height: 28px;
}

.project-notice .project-notice__button::after {
  border: 0;
}
